APP_NAME="Indique e Ganhe"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_BASE_PATH=
APP_TIMEZONE=America/Sao_Paulo

SESSION_NAME=indique_session
SESSION_LIFETIME=7200
SESSION_SECURE=false

# Local (desenvolvimento)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=indique_e_ganhe
DB_USER=root
DB_PASS=

# WhatsApp de suporte do Perfil (opcional; não inventar número)
# SUPPORT_WHATSAPP=

